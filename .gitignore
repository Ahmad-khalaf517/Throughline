# AI agent tooling.
# Third-party skills and machine-local config stay out of the repo; the project's
# OWN skills and agents are committed — they encode frozen ERD / Module Boundaries
# decisions and must be identical for every agent on every machine.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/throughline-*/
!.claude/agents/
!.claude/settings.json
!.claude/commands/
!.claude/hooks/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/throughline-*/
.codex/
skills-lock.json

# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
.env.*.local

# Build output
dist/
build/
.next/
out/

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
# .vscode/ is committed on purpose (Project Setup plan section 5.8)

# next.js / typescript
*.tsbuildinfo
next-env.d.ts
.vercel
/coverage

# drizzle-kit local artifacts (drizzle/migrations/, including its nested
# meta/ snapshots, IS committed - see Project Setup section 3 rule 4)
drizzle/.drizzle-studio/
